# Armenia Life Hub - Environment Variables
# این فایل را به .env کپی کنید و مقادیر را پر کنید

# Database Configuration (برای استفاده از PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/armenia_life_hub?schema=public"

# Application Settings
NODE_ENV=development
VITE_APP_NAME="Armenia Life Hub"
VITE_APP_URL=http://localhost:5173

# JWT Secret (برای authentication در backend)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Email Configuration (اختیاری - برای ارسال ایمیل)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@armenialifehub.com

# File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Demo Accounts (فقط برای development)
DEMO_ADMIN_EMAIL=admin@demo.example.com
DEMO_ADMIN_PASSWORD=DemoAdmin!2026#Hub

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Settings
CORS_ORIGIN=http://localhost:5173
