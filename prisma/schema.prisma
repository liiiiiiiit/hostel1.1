// This is the Prisma schema for PostgreSQL
// To use with real PostgreSQL:
// 1. Install: npm install prisma @prisma/client
// 2. Initialize: npx prisma init
// 3. Copy this schema to prisma/schema.prisma
// 4. Set DATABASE_URL in .env
// 5. Run: npx prisma migrate dev
// 6. Run: npx prisma db seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ACCOUNTS ============

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String
  name          String
  role          Role      @default(GUEST)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  bookings      Booking[]
  applications  JobApplication[]
  
  @@map("users")
}

enum Role {
  SUPER_ADMIN
  HOSTEL_MANAGER
  EMPLOYER
  JOB_SEEKER
  GUEST
}

// ============ HOSTELS ============

model Hostel {
  id                  Int       @id @default(autoincrement())
  slug                String    @unique
  city                String
  address             String
  lat                 Float
  lng                 Float
  amenities           String[]
  checkInTime         String
  checkOutTime        String
  cancellationPolicy  String
  imageUrl            String
  published           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  translations        HostelTranslation[]
  rooms               RoomType[]
  bookings            Booking[]
  
  @@index([city])
  @@index([published])
  @@map("hostels")
}

model HostelTranslation {
  id          Int     @id @default(autoincrement())
  hostelId    Int
  locale      String
  name        String
  description String
  
  hostel      Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  
  @@unique([hostelId, locale])
  @@index([locale])
  @@map("hostel_translations")
}

model RoomType {
  id            Int     @id @default(autoincrement())
  hostelId      Int
  type          RoomTypeType
  beds          Int
  pricePerNight Int
  
  hostel        Hostel  @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  translations  RoomTypeTranslation[]
  bookings      Booking[]
  
  @@index([hostelId])
  @@map("room_types")
}

enum RoomTypeType {
  DORM
  PRIVATE
}

model RoomTypeTranslation {
  id            Int       @id @default(autoincrement())
  roomTypeId    Int
  locale        String
  name          String
  description   String
  
  roomType      RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  
  @@unique([roomTypeId, locale])
  @@index([locale])
  @@map("room_type_translations")
}

model Booking {
  id            Int           @id @default(autoincrement())
  hostelId      Int
  userId        Int
  roomTypeId    Int
  checkIn       DateTime      @db.Date
  checkOut      DateTime      @db.Date
  guests        Int
  status        BookingStatus @default(PENDING)
  guestName     String
  guestEmail    String
  totalPrice    Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  hostel        Hostel        @relation(fields: [hostelId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  roomType      RoomType      @relation(fields: [roomTypeId], references: [id])
  
  @@index([hostelId])
  @@index([userId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
  COMPLETED
}

// ============ EMPLOYMENT ============

model Job {
  id              Int           @id @default(autoincrement())
  companyId       Int
  companyName     String
  city            String
  employmentType  EmploymentType
  salaryMin       Int
  salaryMax       Int
  currency        String        @default("AMD")
  deadline        DateTime      @db.Date
  languages       String[]
  published       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  translations    JobTranslation[]
  applications    JobApplication[]
  
  @@index([city])
  @@index([employmentType])
  @@index([published])
  @@map("jobs")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  REMOTE
}

model JobTranslation {
  id            Int     @id @default(autoincrement())
  jobId         Int
  locale        String
  title         String
  description   String
  requirements  String
  
  job           Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  @@unique([jobId, locale])
  @@index([locale])
  @@map("job_translations")
}

model JobApplication {
  id              Int               @id @default(autoincrement())
  jobId           Int
  userId          Int
  status          ApplicationStatus @default(SUBMITTED)
  coverLetter     String
  applicantName   String
  applicantEmail  String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  job             Job               @relation(fields: [jobId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  
  @@index([jobId])
  @@index([userId])
  @@index([status])
  @@map("job_applications")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  REJECTED
  HIRED
  WITHDRAWN
}

// ============ BUSINESSES ============

model Business {
  id            Int       @id @default(autoincrement())
  category      String
  city          String
  address       String
  lat           Float
  lng           Float
  phone         String
  website       String?
  languages     String[]
  hours         String
  verified      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  translations  BusinessTranslation[]
  
  @@index([category])
  @@index([city])
  @@index([verified])
  @@map("businesses")
}

model BusinessTranslation {
  id            Int       @id @default(autoincrement())
  businessId    Int
  locale        String
  name          String
  description   String
  services      String
  
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  
  @@unique([businessId, locale])
  @@index([locale])
  @@map("business_translations")
}

// ============ ARTICLES ============

model Article {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  category      String
  readingTime   Int
  publishedAt   DateTime      @db.Date
  updatedAt     DateTime      @updatedAt
  status        ArticleStatus @default(DRAFT)
  
  translations  ArticleTranslation[]
  
  @@index([category])
  @@index([status])
  @@map("articles")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ArticleTranslation {
  id          Int     @id @default(autoincrement())
  articleId   Int
  locale      String
  title       String
  excerpt     String
  content     String
  
  article     Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  
  @@unique([articleId, locale])
  @@index([locale])
  @@map("article_translations")
}

// ============ AUDIT LOG ============

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  action      String
  entityType  String
  entityId    Int?
  details     Json?
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
